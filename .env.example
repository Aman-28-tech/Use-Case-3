# Punjab Sports Mart AI Retail Copilot - Environment Configuration
# Copy this file to .env and configure your variables

# Token Harbor / OpenAI compatible API endpoint
OPENAI_API_BASE=https://tokenharbor.ai/v1
OPENAI_BASE_URL=https://tokenharbor.ai/v1
OPENAI_API_KEY=your_token_harbor_key_here

# Anthropic compatible endpoint (optional)
ANTHROPIC_BASE_URL=https://tokenharbor.ai
ANTHROPIC_AUTH_TOKEN=your_token_harbor_key_here

# Model Selection
LLM_MODEL=deepseek-v4-flash:free
FALLBACK_LLM_MODEL=deepseek-v4-flash:free

# Server Configuration
PORT=8000
ANCHOR_TIMESTAMP=2026-10-10 12:00:00
